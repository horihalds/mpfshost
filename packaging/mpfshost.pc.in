prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: mpfshost
Description: Unprivileged client API for the mpfshost MemProcFS host
Version: @PROJECT_VERSION@
Cflags: -I${includedir} -I${includedir}/mpfshost
Libs: -L${libdir} -lmpfshost_client -lmpfshost_ipc -lmpfshost_util -pthread
